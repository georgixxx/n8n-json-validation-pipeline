      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "language": "python",
        "pythonCode": "import jsonschema\n\nschema = {\n    \"type\": \"object\",\n    \"properties\": {\n        \"user_id\": {\"type\": \"integer\"},\n        \"email\": {\"type\": \"string\", \"format\": \"email\"},\n        \"plan\": {\"type\": \"string\", \"enum\": [\"Free\", \"Pro\", \"Enterprise\"]}\n    },\n    \"required\": [\"user_id\", \"email\"]\n}\n\npayload = items[0]['json']\n\ntry:\n    jsonschema.validate(instance=payload, schema=schema)\n    payload['isValid'] = True\nexcept Exception as e:\n    payload['isValid'] = False\n    payload['validationError'] = str(e)\n\nreturn [{\"json\": payload}]"
      },
      "name": "Validate JSON Schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [470, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "notice": "Data successfully validated and moved to production."
      },
      "name": "Success Path",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
